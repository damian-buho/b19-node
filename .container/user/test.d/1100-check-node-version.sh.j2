#!/usr/bin/env bash
set -eo pipefail

ACTUAL=$(get-node-version)
EXPECTED=$(decomment < /deps/node/{{ ENV.B19_NODE_SERIES | int }}/version.deps)

if [ "${ACTUAL}" != "${EXPECTED}" ]
then
  echo "FATAL: expected ${EXPECTED}, got ${ACTUAL}" >&2
  exit 1
fi
